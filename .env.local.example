# Neon Postgres connection string (Neon dashboard → Connection Details).
# Leave empty to serve the built-in festival list from src/data/festivals.ts.
DATABASE_URL=

# Open-Meteo needs no key and is always used.
# Add the keys you have for a stronger multi-source consensus.
OPENWEATHER_API_KEY=
TOMORROW_API_KEY=
WEATHERAPI_API_KEY=

# In-memory weather cache TTL (seconds). Default 1800 (30 min).
# Set higher while testing to avoid rate limits, e.g. 3600 or 7200.
# Set 0 to disable caching.
WEATHER_CACHE_TTL_SECONDS=1800
