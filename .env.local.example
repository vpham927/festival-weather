# Neon Postgres connection string (Neon dashboard → Connection Details).
# Leave empty to serve the built-in festival list from src/data/festivals.ts.
DATABASE_URL=

# Open-Meteo needs no key and is always used.
# Add the keys you have for a stronger multi-source consensus.
OPENWEATHER_API_KEY=
TOMORROW_API_KEY=
WEATHERAPI_API_KEY=
# Google Maps Platform key with Weather API enabled
GOOGLE_WEATHER_API_KEY=

# Weather cache TTL in seconds (default 1800 = 30 min).
# Uses Next.js Data Cache in production so Vercel instances share results.
# Set 0 to disable caching (every request hits upstream APIs).
WEATHER_CACHE_TTL_SECONDS=1800
